# Same Gemini config as the local (non-Vercel) version.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Optional — only needed if you rely on the service-account Sheets API
# fallback instead of appScriptUrl/csvUrl in config/sheets.js.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Required for api/cron-snapshot.js. Vercel automatically sends this value
# as `Authorization: Bearer <value>` when it invokes the cron job — set the
# SAME value here (for local testing) and in your Vercel project's
# Environment Variables (for production). Generate one with e.g.
# `openssl rand -hex 32` or any password generator (16+ random characters).
CRON_SECRET=

# Required for snapshot/report/reminder-number persistence (lib/mongoClient.js).
# A free MongoDB Atlas cluster works fine — create a database (any name,
# code expects "task-tracker"), a database user with read/write access, and
# allow network access from anywhere (0.0.0.0/0) since Vercel's serverless
# functions don't have a fixed IP. Paste the connection string here (for
# local testing) and in your Vercel project's Environment Variables (for
# production).
MONGODB_URI=
